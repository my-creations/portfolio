{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "es5",
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "assets/**/*.png",
    "assets/**/*.jpg",
    "assets/**/*.jpeg",
    "assets/**/*.ico",
    "assets/**/*.pdf"
  ]
}
