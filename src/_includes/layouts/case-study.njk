---
layout: layouts/base.njk
pageType: case-study
---
{% set t = i18n[locale] %}
{% set project = projects | findByKey(projectKey) %}
{% set card = project.card[locale] if project else null %}
{% set workIndexHref = locale | sectionHref('work') %}

<article class="case-study">
  <header class="page__header case-study__header">
    <p class="eyebrow">
      <a href="{{ workIndexHref }}">{{ t.work.title }}</a>
      <span aria-hidden="true"> / </span>
      <span>{{ title }}</span>
    </p>
    <h1 class="page__title">{{ title }}</h1>
    {% if summary %}
    <p class="page__lede">{{ summary }}</p>
    {% elif card %}
    <p class="page__lede">{{ card.subtitle }}</p>
    {% endif %}
    {% if sanitized %}
    <p class="meta-note">{{ t.work.sanitizedNote }}</p>
    {% endif %}
  </header>

  <div class="case-study__layout">
    <aside class="case-study__aside" aria-label="{{ title }}">
      {% if project and project.stack %}
      <section class="aside-block">
        <h2 class="aside-block__title">{{ t.work.stack }}</h2>
        <ul class="chip-list">
          {% for item in project.stack %}
          <li class="chip">{{ item }}</li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      <section class="aside-block">
        <h2 class="aside-block__title">{{ t.work.links }}</h2>
        <ul class="link-list">
          {% if project and project.links.source %}
          <li>
            <a href="{{ project.links.source }}" rel="noopener noreferrer" target="_blank">{{ t.work.source }}</a>
          </li>
          {% else %}
          <li class="muted">{{ t.work.noSource }}</li>
          {% endif %}
          {% if project and project.links.demo %}
          <li>
            <a href="{{ project.links.demo }}" rel="noopener noreferrer" target="_blank">{{ t.work.demo }}</a>
          </li>
          {% else %}
          <li class="muted">{{ t.work.noDemo }}</li>
          {% endif %}
        </ul>
      </section>
    </aside>

    <div class="case-study__content prose">
      {{ content | safe }}
    </div>
  </div>

  {% set siblings = collections.caseStudies | whereLocale(locale) %}
  {% set previousStudy = siblings | getPreviousCollectionItem(page) %}
  {% set nextStudy = siblings | getNextCollectionItem(page) %}
  {% if previousStudy or nextStudy %}
  <nav class="pager" aria-label="{{ t.work.caseStudyNav }}" data-test="case-study-pager">
    {% if previousStudy %}
    <a class="pager__link pager__link--previous" href="{{ previousStudy.url }}" rel="prev">
      <span class="pager__label mono">{{ t.work.previousCaseStudy }}</span>
      <span class="pager__title">{{ previousStudy.data.title }}</span>
    </a>
    {% endif %}
    {% if nextStudy %}
    <a class="pager__link pager__link--next" href="{{ nextStudy.url }}" rel="next">
      <span class="pager__label mono">{{ t.work.nextCaseStudy }}</span>
      <span class="pager__title">{{ nextStudy.data.title }}</span>
    </a>
    {% endif %}
  </nav>
  {% endif %}
</article>
