---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }} — Writing</title>
  <subtitle>{{ site.description.en }}</subtitle>
  <link href="{{ site.url }}{{ '/feed.xml' | url }}" rel="self"/>
  <link href="{{ site.url }}{{ '/' | url }}"/>
  <updated>{% if collections.writing.length %}{{ collections.writing | getNewestCollectionItemDate | dateToRfc3339 }}{% else %}{{ site.buildYear }}-01-01T00:00:00Z{% endif %}</updated>
  <id>{{ site.url }}{{ '/' | url }}</id>
  <author>
    <name>{{ site.author }}</name>
    <email>{{ site.email }}</email>
  </author>
  {%- for post in collections.writing %}
  {%- if post.data.draft != true %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url | url }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ site.url }}{{ post.url | url }}</id>
    <content type="html">{{ post.templateContent | htmlToAbsoluteUrls(site.url + (post.url | url)) }}</content>
  </entry>
  {%- endif %}
  {%- endfor %}
</feed>
